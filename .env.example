SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Sentry — leave blank to disable in local dev
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0

----------------------------
EMAIL_HOST
----------------------------
EMAIL_HOST=smtp.mailgun.org
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@[EMAIL_ADDRESS]
EMAIL_HOST_PASSWORD=your-mailgun-api-key
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False

CSRF_TRUSTED_ORIGINS=

# Optional Gemini integration. JSON mapping of key versions to Fernet keys.
# Generate a dedicated key as described in docs/gemini-briefings.md; never reuse SECRET_KEY.
AI_CREDENTIAL_KEYS=
AI_CREDENTIAL_ACTIVE_KEY=v1
