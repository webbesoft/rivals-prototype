SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Sentry — leave blank to disable in local dev
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0

----------------------------
EMAIL_HOST
----------------------------
EMAIL_HOST=smtp.mailgun.org
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@[EMAIL_ADDRESS]
EMAIL_HOST_PASSWORD=your-mailgun-api-key
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False

CSRF_TRUSTED_ORIGINS=

# Server-side encryption for user-supplied Gemini keys. This is NOT a Gemini API key.
# Each user enters their own Gemini API key in account settings; it is stored encrypted in the database.
# The operator generates this Fernet keyring to protect those stored keys. Never reuse SECRET_KEY.
# Setup: docs/gemini-briefings.md
AI_CREDENTIAL_KEYS=
AI_CREDENTIAL_ACTIVE_KEY=v1
# Emergency switch: false stops new Gemini generations, including queued briefings.
AI_GENERATION_ENABLED=True
