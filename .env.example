# Local development. Production must explicitly configure strong credentials,
# public HTTPS SITE_URL, allowed hosts and a real sender (see docs/deployment.md).
SECRET_KEY=local-development-only-change-for-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
SITE_URL=http://localhost:8000
DEFAULT_FROM_EMAIL=RivalSpy <noreply@example.com>

# Leave blank to disable local telemetry.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
CSRF_TRUSTED_ORIGINS=

# Versioned encryption keyring for user-supplied Gemini keys (not a Gemini key).
# See docs/gemini-briefings.md. Empty disables new Gemini connections.
AI_CREDENTIAL_KEYS=
AI_CREDENTIAL_ACTIVE_KEY=v1
AI_GENERATION_ENABLED=True

# Larger leagues use rank summaries and independently refreshed standings pages.
LEAGUE_FULL_IMPORT_LIMIT=1000
