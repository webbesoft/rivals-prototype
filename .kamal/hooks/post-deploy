#!/bin/bash
# Post-deploy hook for Kamal
# The web startup command applies migrations before receiving traffic.

set -euo pipefail

echo "🔧 Running post-deploy tasks..."

# Player refreshes are now recurring background work. Verify that the job role started.
kamal app exec --reuse --primary --roles job --version "${KAMAL_VERSION:?Kamal must provide the deployed version}" \
    "python manage.py check_fpl_worker --wait 60 --local-progress"

echo "✅ Post-deploy tasks completed!"
