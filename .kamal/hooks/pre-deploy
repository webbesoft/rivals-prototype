#!/bin/bash
# Local release gate: run the complete suites before Kamal boots new containers.
set -euo pipefail

command -v uv >/dev/null || { echo "uv is required for deployment checks." >&2; exit 1; }
command -v node >/dev/null || { echo "Node.js is required for the JavaScript release checks." >&2; exit 1; }

uv python install "$(cat .python-version)"

# Resolve env.clear, secret aliases, and web/job host overrides with Kamal 2.12.0.
ruby .kamal/check-production.rb

# Tests never need production credentials or remote telemetry/email delivery.
export DEBUG=True
export SECRET_KEY=local-release-tests-only-57a624b380fe49f8b23dca6072d9e4a5
export SENTRY_DSN=
export EMAIL_BACKEND=django.core.mail.backends.locmem.EmailBackend
export BACKGROUND_TASK_RUN_ASYNC=False
unset PYTEST_ADDOPTS

uv run --locked python -m pytest -q -o addopts=
node --test tests/js/*.test.cjs
uv run --locked python manage.py check
# Application-owned migrations only; third-party packages maintain their own.
uv run --locked python manage.py makemigrations --check --dry-run accounts api core rivals

echo "Release checks passed."
